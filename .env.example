# ---- DILSOS environment template ----
# Copy to `.env` (repo root, used by docker compose) and/or `backend/.env` (local dev).
# All values below are DEVELOPMENT defaults. Never reuse them in production.

APP_ENV=development
# Demo login is enabled only when APP_ENV != production
DEMO_USER_EMAIL=demo@dilsos.local
DEMO_USER_PASSWORD=demo1234

# JWT — generate a long random value for any shared/production deployment
JWT_SECRET=change-me-dev-only-secret-0123456789abcdef
JWT_EXPIRE_MINUTES=480

# Database (MySQL 8). Local dev: run scripts/mysql_init.sql as root once.
MYSQL_DATABASE=dilsos
MYSQL_USER=dilsos
MYSQL_PASSWORD=dilsos_dev_pw
MYSQL_ROOT_PASSWORD=dilsos_root_dev_pw
DATABASE_URL=mysql+pymysql://dilsos:dilsos_dev_pw@localhost:3306/dilsos?charset=utf8mb4

# Task backend: celery (needs Redis) | db (persistent DB-polling worker) | eager (synchronous, tests)
TASK_BACKEND=db
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Upload / runtime limits
MAX_UPLOAD_BYTES=1048576
MAX_SOLVER_TIME_LIMIT_S=120
RUN_TIMEOUT_S=300

# Frontend (Vite) — API base path; in docker the nginx proxy serves /api
VITE_API_BASE=/api/v1
